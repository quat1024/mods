{
	"schemaVersion": 1,
	"id": "${modid}",
	"version": "${version}",
	"name": "${name}",
	"description": "${description}",
	"authors": [
		"${author}"
	],
	"contact": {
		"homepage": "${homepage}",
		"issues": "${issues}",
		"sources": "${sources}"
	},
	"license": "${license}",
	"icon": "${modid}_modmenu.png",
	"environment": "*",
	"entrypoints": {
		"modder_name_lib:after": [
			"agency.highlysuspect.packages.platform.fabric.FabricInit"
		],
		"modder_name_lib:after_client": [
			"agency.highlysuspect.packages.platform.fabric.client.FabricClientInit"
		],
		"todo-reenable-emi": [
			"agency.highlysuspect.packages.compat.emi.PackagesEmiPlugin"
		]
	},
	"mixins": [
		"packages.mixins.json",
		"packages.fabric.mixins.json"
	],
	"depends": {
		"fabricloader": "*",
		"fabric-api": "*",
		"modder_name_lib": "*",
		"minecraft": ">=${minecraft_version}"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.discord": "https://highlysuspect.agency/discord"
			}
		}
	}
}
