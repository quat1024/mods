import net.fabricmc.loom.task.RemapJarTask
import net.fabricmc.loom.task.AbstractRunTask

plugins {
	id "fabric-loom" // https://maven.fabricmc.net/fabric-loom/fabric-loom.gradle.plugin/
}

static def modVersion(String mod, String version) {
	//null, null -> "modAnyVersionAny"
	//abcd, null -> "modAbcdVersionAny"
	//null, 1.23 -> "modAnyVersion1_23"
	//abcd, 1.23 -> "modAbcdVersion1_23"
	return "mod${mod == null ? "Any" : mod.capitalize()}Version${version == null ? "Any" : version.replace('.', '_')}"
}

def vanillaDep(String mod, String version) {
	return dependencies.project(path: ":vanilla", configuration: "${modVersion(mod, version)}Elements")
}

configurations {
	quatlibVanilla
	implementation.extendsFrom quatlibVanilla
}

dependencies {
	minecraft "com.mojang:minecraft:1.21.1"
	mappings loom.officialMojangMappings()
	
	modImplementation "net.fabricmc:fabric-loader:0.16.14"
	modImplementation "net.fabricmc.fabric-api:fabric-api:0.116.3+1.21.1"
	
	quatlibVanilla vanillaDep(null, null)
	quatlibVanilla vanillaDep(null, "1.21.1")
}

loom.runs {
	client {
		client()
		ideConfigGenerated = true
	}
}

//produce the quatlib jar
//do this first so it can be used as a classpath in projects below it ^^
def quatlibFatDevJar = tasks.register("quatlibFatDevJar", Jar) {
	from sourceSets.main.output
	from configurations.quatlibVanilla.collect { zipTree it }
	
	archiveBaseName = "ModderNameLib-1.21.1-fabric-dev"
	destinationDirectory = tasks.jar.destinationDirectory
}
def quatlibFatMapJar = tasks.register("quatlibFatMapJar", RemapJarTask) {
	archiveBaseName = "ModderNameLib-1.21.1-fabric"
	input = quatlibFatDevJar.flatMap({ it.getArchiveFile() })
	dependsOn quatlibFatDevJar
}
tasks.named("jar") { dependsOn quatlibFatMapJar }

def makeMod2(String mod) {
	println "makeMod2 mod ${mod}"
	String ver = "1.21.1"
	String loader = "fabric"
	
	SourceSet set = sourceSets.create(mod)
	
	//inherit from main sourceset (which contains fabric loader and code shared across fabric 1.21 mods)
	set.compileClasspath += sourceSets.main.compileClasspath
	set.runtimeClasspath += sourceSets.main.runtimeClasspath
	
	//inherit from the relevant :vanilla projects
	//first, the ones broadly applicable to all mods, which end up in quatlib
	Configuration quatlibVanilla = configurations.quatlibVanilla
	
	//then, the mod-specific stuff which is safe to splat into the jar
	Configuration modSplat = configurations.create("${mod}Splat") {
		withDependencies {
			add vanillaDep(mod, null)
			add vanillaDep(mod, ver)
		}
	}
	
	//build the mod's compile classpath (roughly speaking)
	configurations.named(set.implementationConfigurationName) {
		it.withDependencies {
			add project.dependencies.create(sourceSets.main.output) //quatlib for fabric 1.21.1
			add project.dependencies.create(quatlibVanilla) //quatlib for everything
			add project.dependencies.create(modSplat) //code for this mod
		}
	}
	
	//SMALL HACK?? slap this mod's runtime classpath onto the run configs
	//loom run config's "source set" thing isnt gonna know what hit it
	tasks.withType(AbstractRunTask.class).configureEach {
		it.classpath set.runtimeClasspath
	}

	//"dep jar", not a full-fatjar, expects the vanilla stuff to be provided as a dep
	def depDevJar = tasks.register("${modVersion(mod, ver)}Loader${loader.capitalize()}DepDevJar", Jar) {
		from set.output //code specifically for this version of this mod on neoforge
		from modSplat.collect { zipTree it } //code for this mod in :vanilla

		archiveBaseName = "${mod}-${ver}-${loader}-dev"
		destinationDirectory = tasks.jar.destinationDirectory
	}
	
	def depMapJar = tasks.register("${modVersion(mod, ver)}Loader${loader.capitalize()}DepMapJar", RemapJarTask) {
		dependsOn depDevJar, tasks.quatlibFatDevJar, tasks.quatlibFatMapJar
		
		archiveBaseName = "${mod}-${ver}-${loader}"
		input = depDevJar.flatMap({ it.getArchiveFile() })
		
		//put quatlib-fat-dev on the remap classpath so tiny-remapper can see into it
		classpath.from(tasks.quatlibFatDevJar.archiveFile)
		
		//for some reason you can JiJ stuff from RemapJarTask?
		//not sure what that has to do with remapping but ok :thumbs_up: handy
		nestedJars.from(tasks.quatlibFatMapJar.archiveFile)
		addNestedDependencies = true
	}
	tasks.named("jar") { dependsOn depMapJar }
}

makeMod2("testmod")
makeMod2("testmod2")