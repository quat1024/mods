{
	"schemaVersion": 1,
	"id": "${modid}",
	"version": "${version}",
	"name": "${name}",
	"description": "${name} for ${loader} ${minecraft_version}",
	"authors": [
		"${author}"
	],
	"contact": {
		"homepage": "${homepage}",
		"issues": "${issues}",
		"sources": "${sources}"
	},
	"license": "${license}",
	"entrypoints": {
		"main": [
			"agency.highlysuspect.quatlib.craftful.fab.QuatlibFabric"
		],
		"client": [
			"agency.highlysuspect.quatlib.craftful.fab.QuatlibFabricClient"
		]
	},
	"depends": {
		"minecraft": ">=${minecraft_version}",
		"fabricloader": "*",
		"fabric-api": "*"
	}
}