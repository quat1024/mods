{
	"schemaVersion": 1,
	"id": "${modid}",
	"version": "${version}",
	"name": "${name}",
	"description": "${description}",
	"authors": [
		"${author}"
	],
	"contact": {
		"homepage": "${homepage}",
		"issues": "${issues}",
		"sources": "${sources}"
	},
	"license": "${license}",
	"icon": "${modid}_icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"agency.highlysuspect.crowmap.craftful.fab.CrowmapFabric"
		]
	},
	"mixins": [
		"${modid}.mixins.json"
	],
	"depends": {
		"minecraft": ">=${minecraft_version}",
		"modder_name_lib": "*"
	}
}